{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karacter.local/schemas/theme.schema.json",
  "title": "Visual theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "description",
    "builtIn"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "builtIn": {
      "type": "boolean"
    }
  }
}
