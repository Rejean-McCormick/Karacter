{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karacter.local/schemas/milestone.schema.json",
  "title": "Narrative milestone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "order",
    "event",
    "beliefBefore",
    "beliefAfter",
    "behaviorChoice",
    "relationshipIds",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "event": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "beliefBefore": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "beliefAfter": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "behaviorChoice": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "relationshipIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 800
      }
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    }
  }
}
