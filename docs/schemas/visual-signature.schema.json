{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karacter.local/schemas/visual-signature.schema.json",
  "title": "Visual continuity signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "identityAnchors",
    "exclusions"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8192
    },
    "identityAnchors": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 800
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 800
      }
    }
  }
}
