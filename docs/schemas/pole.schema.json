{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karacter.local/schemas/pole.schema.json",
  "title": "Polarity pole",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "visualCues",
    "canHelpWhen",
    "canComplicateWhen"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "visualCues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 800
      }
    },
    "canHelpWhen": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 800
      }
    },
    "canComplicateWhen": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 800
      }
    }
  }
}
